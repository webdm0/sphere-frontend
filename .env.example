# Direct local mode:
NEXT_PUBLIC_API_URL=https://localhost:00000

# Proxy mode alternative:
# NEXT_PUBLIC_API_URL=/backend
# BACKEND_URL=https://localhost:00000

# Server-only. Used by Next.js middleware to validate the backend-issued
# __session_hint cookie. Must match backend SessionHint__Key.
SESSION_HINT_KEY=replace_with_backend_session_hint_key

# Optional server-only stricter validation.
# SESSION_HINT_ISS=
# SESSION_HINT_AUD=
